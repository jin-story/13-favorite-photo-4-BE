// 최종

// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum Grade {
  COMMON
  RARE
  SUPER_RARE
  LEGENDARY
}

enum Genre {
  ALBUM // 앨범
  SPECIAL // 특전
  FAN_SIGN // 팬싸
  SEASON_GREETING // 시즌그리팅
  FAN_MEETING // 팬미팅
  CONCERT // 콘서트
  MD // MD
  COLLABORATION // 콜라보
  FAN_CLUB // 팬클럽
  ETC // 기타
}

model User {
  id                Int          @id @default(autoincrement())
  email             String       @unique
  nickname          String       @unique
  encryptedPassword String?      @map("encrypted_password")
  provider          AuthProvider @default(LOCAL)
  providerId        String?      @map("provider_id")
  points            Int          @default(0)
  refreshToken      String?      @map("refresh_token")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  createdCards      PhotoCard[]
  userInventories   UserInventory[]
  exchangeProposals ExchangeProposal[]
  marketPostings    MarketPosting[]
  pointDraws        PointDraw[]

  purchasesAsBuyer  Transaction[]  @relation("TransactionBuyer")
  purchasesAsSeller Transaction[]  @relation("TransactionSeller")
  notifications     Notification[]

  @@unique([provider, providerId])
  @@map("users")
}

model PhotoCard {
  id            Int      @id @default(autoincrement())
  creatorId     Int      @map("creator_id")
  name          String
  grade         Grade
  genre         Genre
  minPrice      Int      @map("min_price")
  description   String
  imageUrl      String   @map("image_url")
  totalQuantity Int      @map("total_quantity")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  userInventories UserInventory[]
  transactions    Transaction[]
  creator         User            @relation(fields: [creatorId], references: [id])

  @@index([creatorId, createdAt])
  @@index([grade, genre])
  @@map("photo_cards")
}

model UserInventory {
  id                Int                @id @default(autoincrement())
  userId            Int                @map("user_id")
  photoCardId       Int                @map("photo_card_id")
  ownedQuantity     Int                @map("owned_quantity")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  user              User               @relation(fields: [userId], references: [id])
  photoCard         PhotoCard          @relation(fields: [photoCardId], references: [id])
  marketPostings    MarketPosting[]
  exchangeProposals ExchangeProposal[] @relation("OfferedInventory")

  @@unique([userId, photoCardId])
  @@map("user_inventories")
}

// ExchangeProposal
enum ExchangeProposalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model ExchangeProposal {
  id                 Int                    @id @default(autoincrement())
  marketPostingId    Int                    @map("market_posting_id")
  proposerId         Int                    @map("proposer_id")
  offeredInventoryId Int                    @map("offered_inventory_id")
  message            String?
  status             ExchangeProposalStatus @default(PENDING)
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  marketPosting MarketPosting @relation(fields: [marketPostingId], references: [id])

  proposer User @relation(fields: [proposerId], references: [id])

  offeredInventory UserInventory @relation("OfferedInventory", fields: [offeredInventoryId], references: [id])

  notifications Notification[]

  @@index([marketPostingId])
  @@index([proposerId])
  @@map("exchange_proposals")
}

// PointDraw
model PointDraw {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  point     Int
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("point_draws")
}

enum MarketPostingStatus {
  ON_SALE
  SOLD
}

enum PurchaseStatus {
  COMPLETED
  CANCELED
}

model MarketPosting {
  id                  Int                 @id @default(autoincrement())
  sellerId            Int                 @map("seller_id")
  userInventoryId     Int                 @map("user_inventory_id")
  price               Int
  quantity            Int
  remainingQuantity   Int                 @map("remaining_quantity")
  title               String?
  description         String?
  exchangeGrade       Grade?              @map("exchange_grade")
  exchangeGenre       Genre?              @map("exchange_genre")
  exchangeDescription String?             @map("exchange_description")
  status              MarketPostingStatus @default(ON_SALE)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  deletedAt           DateTime?           @map("deleted_at")

  seller            User               @relation(fields: [sellerId], references: [id])
  userInventory     UserInventory      @relation(fields: [userInventoryId], references: [id])
  transactions      Transaction[]
  exchangeProposals ExchangeProposal[]
  notifications     Notification[]

  @@index([sellerId])
  @@index([userInventoryId])
  @@index([status])
  @@index([deletedAt])
  @@index([status, deletedAt])
  @@map("market_postings")
}

model Transaction {
  id               Int            @id @default(autoincrement())
  marketPostingId  Int            @map("market_posting_id")
  buyerId          Int            @map("buyer_id")
  sellerId         Int            @map("seller_id")
  photoCardId      Int            @map("photo_card_id")
  transactionPrice Int            @map("transaction_price")
  quantity         Int
  status           PurchaseStatus @default(COMPLETED)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  marketPosting MarketPosting  @relation(fields: [marketPostingId], references: [id])
  buyer         User           @relation("TransactionBuyer", fields: [buyerId], references: [id])
  seller        User           @relation("TransactionSeller", fields: [sellerId], references: [id])
  photoCard     PhotoCard      @relation(fields: [photoCardId], references: [id])
  notifications Notification[]

  @@index([marketPostingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([photoCardId])
  @@index([status])
  @@index([createdAt])
  @@map("transactions")
}
enum NotificationType {
  TRANSACTION_COMPLETED
  MARKET_POSTING_SOLD
  MARKET_POSTING_SOLD_OUT
  EXCHANGE_PROPOSAL_RECEIVED
  EXCHANGE_PROPOSAL_APPROVED
  EXCHANGE_PROPOSAL_REJECTED
}

model Notification {
  id                 Int              @id @default(autoincrement())
  userId             Int              @map("user_id")
  marketPostingId    Int?             @map("market_posting_id")
  transactionId      Int?             @map("transaction_id")
  exchangeProposalId Int?             @map("exchange_proposal_id")
  type               NotificationType
  message            String
  isRead             Boolean          @default(false) @map("is_read")
  readAt             DateTime?        @map("read_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id])
  marketPosting    MarketPosting?    @relation(fields: [marketPostingId], references: [id])
  transaction      Transaction?      @relation(fields: [transactionId], references: [id])
  exchangeProposal ExchangeProposal? @relation(fields: [exchangeProposalId], references: [id])

  @@index([userId, isRead])
  @@index([marketPostingId])
  @@index([transactionId])
  @@index([exchangeProposalId])
  @@index([createdAt])
  @@index([type])
  @@map("notifications")
}
