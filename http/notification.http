@baseUrl = http://localhost:3001

# user1의 access token
@user1Token = Access token 적기

# user2의 access token
@user2Token = Access token 적기

# user1 소유이며 아직 읽지 않은 알림
@unreadNotificationId = 1

# user2가 소유한 알림
@otherUserNotificationId = 3

# DB에 존재하지 않는 양의 정수 ID
@missingNotificationId = 999999

# user1이 등록한 판매 중인 판매글
@marketPostingId = 12

# user2가 실제로 보유한 교환 제시용 inventory ID
@offeredInventoryId = 101

# 새교환에서 생성받은 응답 ID
@exchangeProposalId = 13

### 교환 제안 생성 user1이 user2의 판매글에 제안
POST {{baseUrl}}/market-postings/{{marketPostingId}}/exchange-proposals
Authorization: Bearer {{user1Token}}
Content-Type: application/json

{
  "offeredInventoryId": {{offeredInventoryId}},
  "message": "교환 제안 승인 알림 테스트하려고요"
}

### 판매자 알림 조회 교환 제안 도착 알림 확인
GET {{baseUrl}}/users/me/notifications
Authorization: Bearer {{user2Token}}

### user2가 교환 제안 거절
PATCH {{baseUrl}}/exchange-proposals/{{exchangeProposalId}}
Authorization: Bearer {{user2Token}}
Content-Type: application/json

{
  "status": "REJECTED"
}

### 교환 제안자 알림 조회 user1의 거절 알림 확인
GET {{baseUrl}}/users/me/notifications
Authorization: Bearer {{user1Token}}

### 판매자가 교환 제안 승인
PATCH {{baseUrl}}/exchange-proposals/{{exchangeProposalId}}
Authorization: Bearer {{user2Token}}
Content-Type: application/json

{
  "status": "APPROVED"
}

### 교환 제안자 알림 조회 승인 알림 확인
GET {{baseUrl}}/users/me/notifications
Authorization: Bearer {{user1Token}}

### 내 알림 목록 조회
GET {{baseUrl}}/users/me/notifications
Authorization: Bearer {{user1Token}}


### user2의 알림 목록 조회
GET {{baseUrl}}/users/me/notifications
Authorization: Bearer {{user2Token}}


### 인증 없이 내 알림 목록 조회
GET {{baseUrl}}/users/me/notifications


### 읽지 않은 본인 알림 읽음 처리
PATCH {{baseUrl}}/users/me/notifications/{{unreadNotificationId}}
Authorization: Bearer {{user1Token}}


### 동일한 알림 다시 읽음 처리
PATCH {{baseUrl}}/users/me/notifications/{{unreadNotificationId}}
Authorization: Bearer {{user1Token}}


### 읽음 처리 후 목록 다시 조회
GET {{baseUrl}}/users/me/notifications
Authorization: Bearer {{user1Token}}


### user2 읽지 않은 본인 알림 읽음 처리
PATCH {{baseUrl}}/users/me/notifications/{{otherUserNotificationId}}
Authorization: Bearer {{user2Token}}


### user2 동일한 알림 다시 읽음 처리
PATCH {{baseUrl}}/users/me/notifications/{{otherUserNotificationId}}
Authorization: Bearer {{user2Token}}


### user2 읽음 처리 후 목록 다시 조회
GET {{baseUrl}}/users/me/notifications
Authorization: Bearer {{user2Token}}

### 숫자가 아닌 notificationId
PATCH {{baseUrl}}/users/me/notifications/abc
Authorization: Bearer {{user1Token}}


### notificationId가 0
PATCH {{baseUrl}}/users/me/notifications/0
Authorization: Bearer {{user1Token}}


### notificationId가 음수
PATCH {{baseUrl}}/users/me/notifications/-1
Authorization: Bearer {{user1Token}}


### notificationId가 소수
PATCH {{baseUrl}}/users/me/notifications/1.5
Authorization: Bearer {{user1Token}}


### 존재하지 않는 알림
PATCH {{baseUrl}}/users/me/notifications/{{missingNotificationId}}
Authorization: Bearer {{user1Token}}


### 다른 사용자가 소유한 알림
PATCH {{baseUrl}}/users/me/notifications/{{otherUserNotificationId}}
Authorization: Bearer {{user1Token}}


### 다른 사용자 알림이 변경되지 않았는지 확인
GET {{baseUrl}}/users/me/notifications
Authorization: Bearer {{user2Token}}


### 인증 없이 알림 읽음 처리
PATCH {{baseUrl}}/users/me/notifications/{{unreadNotificationId}}


