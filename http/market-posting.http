@baseUrl = http://localhost:3001
@accessToken =
@marketPostingId = 101
@userInventoryId =

### 전체 판매글 목록 조회
GET {{baseUrl}}/market-postings?page=1&limit=10&sort=recent

### 전체 판매글 목록 조회 - 검색/필터
GET {{baseUrl}}/market-postings?page=1&limit=10&keyword=winter&grade=RARE&genre=SPECIAL&sort=price_asc

### 판매글 등록
POST {{baseUrl}}/market-postings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "userInventoryId": {{userInventoryId}},
  "quantity": 1,
  "price": 1000,
  "title": "Winter Special Card 판매",
  "description": "상태 좋은 포토카드입니다.",
  "exchangeGrade": "RARE",
  "exchangeGenre": "SPECIAL",
  "exchangeDescription": "RARE 이상 카드와 교환 희망"
}

### 판매글 상세 조회
GET {{baseUrl}}/market-postings/{{marketPostingId}}
Authorization: Bearer {{accessToken}}

### 포토카드 구매
POST {{baseUrl}}/market-postings/{{marketPostingId}}/transactions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "quantity": 1
}

### 판매글 수정
PATCH {{baseUrl}}/market-postings/{{marketPostingId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "quantity": 1,
  "price": 1200,
  "title": "Winter Special Card 판매",
  "description": "가격을 조정했습니다.",
  "exchangeGrade": "SUPER_RARE",
  "exchangeGenre": "SPECIAL",
  "exchangeDescription": "SUPER_RARE 카드와 교환 희망"
}

### 판매글 내리기
DELETE {{baseUrl}}/market-postings/{{marketPostingId}}
Authorization: Bearer {{accessToken}}
